# Only the agreed code and documentation are tracked at the project root.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Source/
!/Plugins/
!/Docs/

/Source/*
!/Source/UE_MCPTest.Target.cs
!/Source/UE_MCPTestEditor.Target.cs
!/Source/UE_MCPTest/
/Source/UE_MCPTest/*
!/Source/UE_MCPTest/UE_MCPTest.Build.cs
!/Source/UE_MCPTest/Private/
!/Source/UE_MCPTest/Public/

/Plugins/*
!/Plugins/WorldPartitionRVTBake/
!/Plugins/TYWaterfallTools/

/Plugins/WorldPartitionRVTBake/*
!/Plugins/WorldPartitionRVTBake/Source/
!/Plugins/WorldPartitionRVTBake/Scripts/
!/Plugins/WorldPartitionRVTBake/Resources/
!/Plugins/WorldPartitionRVTBake/WorldPartitionRVTBake.uplugin
!/Plugins/WorldPartitionRVTBake/README.md
!/Plugins/WorldPartitionRVTBake/TEST_RESULTS.md

/Plugins/TYWaterfallTools/*
!/Plugins/TYWaterfallTools/Source/
!/Plugins/TYWaterfallTools/Config/
!/Plugins/TYWaterfallTools/Resources/
!/Plugins/TYWaterfallTools/Docs/
!/Plugins/TYWaterfallTools/TYWaterfallTools.uplugin
!/Plugins/TYWaterfallTools/.gitignore

# Root Docs tracks Markdown at any depth, including future documents.
/Docs/**
!/Docs/**/
!/Docs/**/*.md

# Never include Unreal build outputs, content assets, or local tooling.
**/Content/
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/.vs/
**/.idea/
**/.vscode/
**/__pycache__/
*.pyc
*.pyo
*.suo
*.user
*.userprefs
*.tmp
*.log
.DS_Store
Thumbs.db
